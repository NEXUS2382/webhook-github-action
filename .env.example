# Render Configuration
RENDER_WEBHOOK_SECRET=your_render_webhook_secret_here
RENDER_API_KEY=your_render_api_key_here
RENDER_API_URL=https://api.render.com/v1

# GitHub Configuration
GITHUB_API_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER_NAME=your_github_owner_name
GITHUB_REPO_NAME=your_github_repo_name
GITHUB_WORKFLOW_ID=example.yaml

# Stripe Configuration for Instant Payments
STRIPE_API_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_RETURN_URL=http://localhost:3001/payment-success

# Optional: Stripe Publishable Key (for frontend use)
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Server Configuration
PORT=3001
NODE_ENV=production
